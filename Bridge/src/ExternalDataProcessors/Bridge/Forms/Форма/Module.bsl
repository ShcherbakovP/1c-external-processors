#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВыполнитьЗаданиеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗавершитьРаботуСистемы(Ложь, Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// Bridge evidence — внешняя обработка-мост (этап 1 конвейера CI/CD).
// Запускается пакетно: 1cv8 ENTERPRISE /Execute Bridge.epf против серверной тест-ИБ.
// Точка входа — обработчики формы (ПриСозданииНаСервере на сервере, ПриОткрытии завершает сеанс).
// Контракт задания: /tmp/bridge/task.json. Результат: /tmp/bridge/out/<name>.{mxl,txt,result.json}.
// Машинную оценку (assessment.json по expect) делает bridge.sh, не обработка.

&НаСервере
Процедура ВыполнитьЗаданиеНаСервере()
	КаталогМоста = "/tmp/bridge";
	КаталогВыхода = КаталогМоста + "/out";
	Попытка
		СоздатьКаталог(КаталогВыхода);
	Исключение
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("name", "unknown");
	Результат.Вставить("type", "");
	Результат.Вставить("executed", Ложь);
	Результат.Вставить("error", Ложь);
	Результат.Вставить("errorText", "");
	Результат.Вставить("columns", Новый Массив);
	Результат.Вставить("rowCount", 0);

	Имя = "unknown";

	Попытка
		Задание = ПрочитатьЗадание(КаталогМоста + "/task.json");

		ИмяИзЗадания = Задание.Получить("name");
		Если ЗначениеЗаполнено(ИмяИзЗадания) Тогда
			Имя = Строка(ИмяИзЗадания);
		КонецЕсли;
		Результат.name = Имя;

		Тип = Задание.Получить("type");
		Если НЕ ЗначениеЗаполнено(Тип) Тогда
			Тип = "query";
		КонецЕсли;
		Результат.type = Тип;

		Если Тип = "query" Тогда
			ВыполнитьЗапрос(Задание, Результат, КаталогВыхода, Имя);
		ИначеЕсли Тип = "report" Тогда
			ВыполнитьОтчёт(Задание, Результат, КаталогВыхода, Имя);
		Иначе
			Результат.error = Истина;
			Результат.errorText = "неизвестный тип задания: " + Тип;
		КонецЕсли;
	Исключение
		Результат.error = Истина;
		Результат.errorText = ОписаниеОшибки();
	КонецПопытки;

	ЗаписатьРезультат(Результат, КаталогВыхода + "/" + Имя + ".result.json");
КонецПроцедуры

&НаСервере
Функция ПрочитатьЗадание(Путь)
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Задание = ПрочитатьJSON(Чтение, Истина); // в Соответствие — устойчиво к произвольным ключам
	Чтение.Закрыть();
	Возврат Задание;
КонецФункции

&НаСервере
Процедура ВыполнитьЗапрос(Задание, Результат, КаталогВыхода, Имя)
	ТекстЗапроса = Задание.Получить("query");
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Результат.error = Истина;
		Результат.errorText = "пустой текст запроса (query)";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(Строка(ТекстЗапроса));
	Парамы = Задание.Получить("params");
	Если ТипЗнч(Парамы) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Парамы Цикл
			Запрос.УстановитьПараметр(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Таблица = Запрос.Выполнить().Выгрузить();
	Результат.executed = Истина;
	Результат.rowCount = Таблица.Количество();

	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	Результат.columns = МассивКолонок;

	ЗаписатьMXL(Таблица, КаталогВыхода + "/" + Имя + ".mxl");
	ЗаписатьTXT(Таблица, КаталогВыхода + "/" + Имя + ".txt");
КонецПроцедуры

&НаСервере
Процедура ЗаписатьMXL(Таблица, Путь)
	ТабДок = Новый ТабличныйДокумент;
	НомерКолонки = 1;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ТабДок.Область(1, НомерКолонки).Текст = Колонка.Имя;
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	НомерСтроки = 2;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерКолонки = 1;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ТабДок.Область(НомерСтроки, НомерКолонки).Текст = Строка(СтрокаТаблицы[Колонка.Имя]);
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	ТабДок.Записать(Путь, ТипФайлаТабличногоДокумента.MXL);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьTXT(Таблица, Путь)
	Текст = Новый ТекстовыйДокумент;
	СтрокаЗаголовков = "";
	Для Каждого Колонка Из Таблица.Колонки Цикл
		СтрокаЗаголовков = СтрокаЗаголовков + ?(СтрокаЗаголовков = "", "", Символы.Таб) + Колонка.Имя;
	КонецЦикла;
	Текст.ДобавитьСтроку(СтрокаЗаголовков);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаДанных = "";
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаДанных = СтрокаДанных + ?(СтрокаДанных = "", "", Символы.Таб) + Строка(СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Текст.ДобавитьСтроку(СтрокаДанных);
	КонецЦикла;
	Текст.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРезультат(Результат, Путь)
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, , , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();
КонецПроцедуры

// type=report — запуск СКД из .dcs ветки: рендер в MXL (отчёт) + ТаблицаЗначений (txt + метаданные).
&НаСервере
Процедура ВыполнитьОтчёт(Задание, Результат, КаталогВыхода, Имя)
	ИмяСхемы = Задание.Получить("dcs");
	Если НЕ ЗначениеЗаполнено(ИмяСхемы) Тогда
		Результат.error = Истина;
		Результат.errorText = "не указан файл схемы СКД (dcs)";
		Возврат;
	КонецЕсли;
	ПутьСхемы = "/tmp/bridge/" + Строка(ИмяСхемы);
	ФайлСхемы = Новый Файл(ПутьСхемы);
	Если НЕ ФайлСхемы.Существует() Тогда
		Результат.error = Истина;
		Результат.errorText = "схема СКД не найдена: " + ПутьСхемы;
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьСхемы);
	Схема = СериализаторXDTO.ПрочитатьXML(Чтение, Тип("СхемаКомпоновкиДанных"));
	Чтение.Закрыть();

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Если Схема.НастройкиПоУмолчанию <> Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	КонецЕсли;
	Настройки = Компоновщик.Настройки; // редактируемые (ПолучитьНастройки даёт скомпонованную копию)

	// Схема обязана нести выводящую структуру варианта (как любой боевой отчёт). Пустую не обрабатываем.
	Если Настройки.Структура.Количество() = 0 Тогда
		Результат.error = Истина;
		Результат.errorText = "схема СКД без выводящей структуры (нужен вариант настроек с группировкой)";
		Возврат;
	КонецЕсли;

	Парамы = Задание.Получить("params");
	Если ТипЗнч(Парамы) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Парамы Цикл
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	// 1) В ТаблицуЗначений — для txt и метаданных result.json.
	Таблица = СкомпоноватьВТаблицу(Схема, Настройки);
	Результат.executed = Истина;
	Результат.rowCount = Таблица.Количество();
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	Результат.columns = МассивКолонок;
	ЗаписатьTXT(Таблица, КаталогВыхода + "/" + Имя + ".txt");

	// 2) В ТабличныйДокумент — MXL (рендер отчёта).
	ТабДок = СкомпоноватьВДокумент(Схема, Настройки);
	ТабДок.Записать(КаталогВыхода + "/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
КонецПроцедуры

&НаСервере
Функция СкомпоноватьВТаблицу(Схема, Настройки)
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	ВыводВКоллекцию = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Таблица = Новый ТаблицаЗначений;
	ВыводВКоллекцию.УстановитьОбъект(Таблица);
	ВыводВКоллекцию.Вывести(Процессор);
	Возврат Таблица;
КонецФункции

&НаСервере
Функция СкомпоноватьВДокумент(Схема, Настройки)
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	ВыводВДокумент = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ТабДок = Новый ТабличныйДокумент;
	ВыводВДокумент.УстановитьДокумент(ТабДок);
	ВыводВДокумент.Вывести(Процессор);
	Возврат ТабДок;
КонецФункции

#КонецОбласти
