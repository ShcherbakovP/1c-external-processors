// Модуль формы IKassaПробник.
// Логика тонкая — вся работа идёт через РеквизитФормыВЗначение("Объект").

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Адрес = "192.168.0.100";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		Порт = 37015;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Кассир) Тогда
		Кассир = "Тест";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Авторизоваться(Команда)
	Если НЕ ПроверитьПараметры() Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьОперациюНаСервере("AUTH");
КонецПроцедуры

&НаКлиенте
Процедура XОтчёт(Команда)
	ВыполнитьОперациюНаСервере("X_REPORT");
КонецПроцедуры

&НаКлиенте
Процедура ДокументыСмены(Команда)
	ВыполнитьОперациюНаСервере("GET_SHIFT_DOCUMENTS");
КонецПроцедуры

&НаКлиенте
Процедура ТестПечати(Команда)
	ВыполнитьОперациюНаСервере("PRINT_BASE64");
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЛоги(Команда)
	ВыполнитьОперациюНаСервере("UPLOAD_LOGS");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛог(Команда)
	Лог.УстановитьТекст("");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПроверитьПараметры()
	Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ НЕ ЗначениеЗаполнено(Порт) ИЛИ НЕ ЗначениеЗаполнено(PIN) Тогда
		ПоказатьПредупреждение(, "Заполните адрес, порт и PIN");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ВыполнитьОперациюНаСервере(ТипОперации)
	Объект = РеквизитФормыВЗначение("Объект");
	Параметры = Новый Структура("Адрес, Порт, PIN, Кассир", Адрес, Порт, PIN, Кассир);

	НовыйЛог = Новый ТекстовыйДокумент;
	НовыйЛог.УстановитьТекст(Лог.ПолучитьТекст());

	Если ТипОперации = "AUTH" Тогда
		Результат = Объект.АвторизоватьСКО(Параметры, НовыйЛог);
		Если Результат.Успех Тогда
			AuthToken = Результат.Токен;
			ТокенДо = Результат.ТокенДо;
		КонецЕсли;
	ИначеЕсли ТипОперации = "X_REPORT" Тогда
		Результат = Объект.ВыполнитьXОтчёт(Параметры, AuthToken, НовыйЛог);
	ИначеЕсли ТипОперации = "GET_SHIFT_DOCUMENTS" Тогда
		Результат = Объект.ПолучитьДокументыСмены(Параметры, AuthToken, НовыйЛог);
	ИначеЕсли ТипОперации = "PRINT_BASE64" Тогда
		Результат = Объект.ТестоваяПечать(Параметры, AuthToken, "MVP TEST " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), НовыйЛог);
	ИначеЕсли ТипОперации = "UPLOAD_LOGS" Тогда
		Результат = Объект.ВыгрузитьЛогиКассы(Параметры, AuthToken, НовыйЛог);
	КонецЕсли;

	Лог.УстановитьТекст(НовыйЛог.ПолучитьТекст());
КонецПроцедуры

#КонецОбласти
