// IKassaПробник — MVP-обработка для проверки связи с PAX A930 (Smart X API).
// Только нефискальные / read-only операции: AUTH, X_REPORT, GET_SHIFT_DOCUMENTS,
// UPLOAD_LOGS, PRINT_BASE64, SSDP discovery.
//
// Архитектурно: BSL-код концентрируется в модуле объекта обработки,
// форма дёргает экспортные методы через РеквизитФормыВЗначение("Объект").

#Область ПрограммныйИнтерфейс

// Авторизация в СКО.
//
// Параметры:
//  Параметры - Структура - Адрес, Порт, PIN.
//  Лог       - см. ДобавитьВЛог.
//
// Возвращаемое значение:
//  Структура:
//    * Успех    - Булево
//    * Токен    - Строка - 24-ч токен авторизации
//    * ТокенДо  - Дата
//    * Ответ    - Соответствие - распарсенный BaseResponse
//
Функция АвторизоватьСКО(Параметры, Лог) Экспорт
	Тело = Новый Структура;
	Тело.Вставить("pin", Параметры.PIN);
	Тело.Вставить("rememberPin", Истина);
	Тело.Вставить("returnToken", Истина);

	Результат = ВыполнитьЗапрос(Параметры, "AUTH", Тело, "", Лог);

	Если Результат.Успех Тогда
		Токен = ?(Результат.Ответ.Получить("token") = Неопределено, "", Результат.Ответ["token"]);
		Результат.Вставить("Токен", Токен);
		Результат.Вставить("ТокенДо", ТекущаяДатаСеанса() + 24 * 60 * 60);
	КонецЕсли;

	Возврат Результат;
КонецФункции

// X-отчёт без закрытия смены. Read-only.
Функция ВыполнитьXОтчёт(Параметры, AuthToken, Лог) Экспорт
	Тело = Новый Структура("cashier", Параметры.Кассир);
	Возврат ВыполнитьЗапрос(Параметры, "X_REPORT", Тело, AuthToken, Лог);
КонецФункции

// Журнал кассовых документов текущей смены. Read-only.
Функция ПолучитьДокументыСмены(Параметры, AuthToken, Лог) Экспорт
	Тело = Новый Структура;
	Возврат ВыполнитьЗапрос(Параметры, "GET_SHIFT_DOCUMENTS", Тело, AuthToken, Лог);
КонецФункции

// Нефискальная печать произвольной строки. Не влияет на СКО.
Функция ТестоваяПечать(Параметры, AuthToken, ТекстДляПечати, Лог) Экспорт
	Base64Текст = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ТекстДляПечати, "UTF-8"));
	Тело = Новый Структура;
	Тело.Вставить("is_image", Ложь);
	Тело.Вставить("data_base64", Base64Текст);
	Возврат ВыполнитьЗапрос(Параметры, "PRINT_BASE64", Тело, AuthToken, Лог);
КонецФункции

// Выгрузка логов кассы.
Функция ВыгрузитьЛогиКассы(Параметры, AuthToken, Лог) Экспорт
	Тело = Новый Структура;
	Возврат ВыполнитьЗапрос(Параметры, "UPLOAD_LOGS", Тело, AuthToken, Лог);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Базовая обёртка над HTTP-запросом к Smart X.
Функция ВыполнитьЗапрос(Параметры, ТипОперации, Тело, AuthToken, Лог)
	URL = "http://" + Параметры.Адрес + ":" + Формат(Параметры.Порт, "ЧГ=") + "/v1";

	ТелоJSON = СериализоватьВJSON(Тело);

	HTTPЗапрос = Новый HTTPЗапрос("/v1");
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("INTENT_OPERATION_TYPE", ТипОперации);
	Если ЗначениеЗаполнено(AuthToken) Тогда
		HTTPЗапрос.Заголовки.Вставить("Auth-token", AuthToken);
	КонецЕсли;
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);

	ДобавитьВЛог(Лог, "→ POST " + URL + " (" + ТипОперации + ")");
	ДобавитьВЛог(Лог, "  BODY: " + СкрытьСекреты(ТелоJSON));

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура("Успех, Ответ, ТекстОшибки, ВремяМс", Ложь, Новый Соответствие, "", 0);
	Попытка
		HTTPСоединение = Новый HTTPСоединение(Параметры.Адрес, Параметры.Порт, , , , 30);
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		Результат.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

		ДобавитьВЛог(Лог, "← " + HTTPОтвет.КодСостояния + " (" + Результат.ВремяМс + " мс)");
		ДобавитьВЛог(Лог, "  BODY: " + ТелоОтвета);

		Если HTTPОтвет.КодСостояния = 200 И ЗначениеЗаполнено(ТелоОтвета) Тогда
			Результат.Ответ = ДесериализоватьJSON(ТелоОтвета);
			Результат.Успех = Истина;
		Иначе
			Результат.ТекстОшибки = "HTTP " + HTTPОтвет.КодСостояния;
			Результат.Ответ = ?(ЗначениеЗаполнено(ТелоОтвета), ДесериализоватьJSON(ТелоОтвета), Новый Соответствие);
		КонецЕсли;
	Исключение
		Результат.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ДобавитьВЛог(Лог, "✗ ОШИБКА: " + Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция СериализоватьВJSON(Знач Значение)
	Запись = Новый ЗаписьJSON;
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	Запись.УстановитьСтроку(Параметры);
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ДесериализоватьJSON(Знач Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция СкрытьСекреты(Знач ТелоJSON)
	Возврат СтрЗаменить(ТелоJSON, """pin""", """pin"":""***""//");
КонецФункции

Процедура ДобавитьВЛог(Лог, Сообщение)
	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Метка = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");
	Лог.ДобавитьСтроку("[" + Метка + "] " + Сообщение);
КонецПроцедуры

#КонецОбласти
