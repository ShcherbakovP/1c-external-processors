////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "ОчисткаКопииДляDev".
//
// Назначение: непосредственное (без пометки) удаление служебных и историйных
// данных из копии рабочей базы перед разворачиванием dev-базы.
// Удаление идёт порциями в отдельных транзакциях, с индикацией прогресса.
// Прерывание — Ctrl+Break (срабатывает между порциями), запуск можно повторять:
// обработка продолжит с оставшихся записей.
//
// Два режима по реквизиту ДатаОтсечки:
//  - дата пустая  — полная очистка отмеченных категорий (как раньше);
//  - дата задана  — обрезка по периоду: удаляются только записи старше даты,
//    записи с этой даты сохраняются. Применяется к объектам с реквизитом-датой
//    (журнал AEMZ — Период, история — Дата, периодические регистры — Период);
//    объекты без реквизита-даты пропускаются. У иерархического справочника
//    удаляются только записи-листья, группы не трогаются.
//
// Целевая конфигурация — обычное приложение, поэтому весь код модуля формы
// исполняется в толстом клиенте с полным доступом к данным.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

Процедура ПриОткрытии()

	Если РазмерПорции <= 0 Тогда
		РазмерПорции = 5000;
	КонецЕсли;
	ТекстРезультата = "";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Действие кнопки "Посчитать". Показывает количество записей по отмеченным
// категориям без удаления.
//
// Параметры:
//  Кнопка - КнопкаФормы - источник события.
//
Процедура КнопкаПосчитатьНажатие(Кнопка)

	ТекстРезультата = "";
	ВыполнитьОбработку(Истина);

КонецПроцедуры

// Действие кнопки "Удалить отмеченное". Непосредственно удаляет данные
// отмеченных категорий порциями.
//
// Параметры:
//  Кнопка - КнопкаФормы - источник события.
//
Процедура КнопкаВыполнитьНажатие(Кнопка)

	ТекстРезультата = "";
	ВыполнитьОбработку(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основной сценарий: подсчёт записей по отмеченным категориям и, если это не
// режим подсчёта, непосредственное удаление с подтверждением и прогрессом.
//
// Параметры:
//  РежимТолькоПодсчет - Булево - Истина: только посчитать и показать, не удалять.
//
Процедура ВыполнитьОбработку(РежимТолькоПодсчет)

	Если РазмерПорции <= 0 Тогда
		РазмерПорции = 5000;
	КонецЕсли;

	Объекты = СписокОбъектов();
	Если Объекты.Количество() = 0 Тогда
		Предупреждение("Не отмечена ни одна категория для очистки.");
		Возврат;
	КонецЕсли;

	ОбрезкаПоПериоду = ЗначениеЗаполнено(ДатаОтсечки);
	Если ОбрезкаПоПериоду Тогда
		ДобавитьВЛог("Режим: обрезка по периоду — удаляются записи старше "
			+ Формат(ДатаОтсечки, "ДЛФ=D") + ", записи с этой даты сохраняются.");
		Объекты = ОтобратьОбрезаемые(Объекты);
		Если Объекты.Количество() = 0 Тогда
			ДобавитьВЛог("Среди отмеченных категорий нет объектов с реквизитом даты — обрезать нечего.");
			Возврат;
		КонецЕсли;
	Иначе
		ДобавитьВЛог("Режим: полная очистка отмеченных категорий без отбора по дате.");
	КонецЕсли;

	ОбщееКоличество = 0;
	Для Каждого ОписаниеОбъекта Из Объекты Цикл
		ОписаниеОбъекта.Количество = КоличествоЗаписей(ОписаниеОбъекта.ПолноеИмя, ОписаниеОбъекта.РеквизитПериода);
		ОбщееКоличество = ОбщееКоличество + ОписаниеОбъекта.Количество;
		ДобавитьВЛог(ОписаниеОбъекта.ПолноеИмя + ": " + Формат(ОписаниеОбъекта.Количество, "ЧГ=0"));
	КонецЦикла;
	ДобавитьВЛог("ИТОГО к обработке: " + Формат(ОбщееКоличество, "ЧГ=0") + " записей");

	Если РежимТолькоПодсчет Тогда
		Состояние("Подсчёт завершён");
		Возврат;
	КонецЕсли;

	Если ОбщееКоличество = 0 Тогда
		ДобавитьВЛог("Удалять нечего.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будет НЕПОСРЕДСТВЕННО удалено " + Формат(ОбщееКоличество, "ЧГ=0")
		+ " записей без возможности восстановления.";
	Если ОбрезкаПоПериоду Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Удаляются только записи старше "
			+ Формат(ДатаОтсечки, "ДЛФ=D") + ".";
	КонецЕсли;
	ТекстВопроса = ТекстВопроса + " Продолжить?";
	Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		ДобавитьВЛог("Отменено пользователем.");
		Возврат;
	КонецЕсли;

	ВремяНачала = ТекущаяДатаСеанса();
	Обработано = 0;
	ВсегоОбъектов = Объекты.Количество();
	НомерОбъекта = 0;
	Для Каждого ОписаниеОбъекта Из Объекты Цикл
		НомерОбъекта = НомерОбъекта + 1;
		Подпись = "[" + НомерОбъекта + "/" + ВсегоОбъектов + "] " + ОписаниеОбъекта.ПолноеИмя;
		Если ОписаниеОбъекта.Вид = "Регистр" Тогда
			Обработано = Обработано + ОчиститьРегистрСведений(ОписаниеОбъекта, ОбщееКоличество, Обработано, Подпись);
		Иначе
			Обработано = Обработано + ОчиститьСсылочныйОбъект(ОписаниеОбъекта, ОбщееКоличество, Обработано, Подпись);
		КонецЕсли;
	КонецЦикла;

	Состояние("Готово");
	Длительность = ТекущаяДатаСеанса() - ВремяНачала;
	ДобавитьВЛог("Удаление завершено. Обработано " + Формат(Обработано, "ЧГ=0")
		+ " записей за " + Формат(Длительность, "ЧГ=0") + " сек.");

КонецПроцедуры

// Удаляет ссылочный объект (справочник или документ) порциями по РазмерПорции.
// Каждая порция фиксируется отдельной транзакцией.
//
// Параметры:
//  ОписаниеОбъекта - Структура - поля ПолноеИмя, Вид, ИмяКороткое, Количество.
//  ОбщееКоличество - Число - всего записей по выбранным объектам (для прогресса).
//  УжеОбработано - Число - удалено до этого объекта (для прогресса).
//  Подпись - Строка - текст для окна состояния, например "[3/12] Справочник.Файлы".
//
// Возвращаемое значение:
//  Число - количество удалённых записей этого объекта.
//
Функция ОчиститьСсылочныйОбъект(ОписаниеОбъекта, ОбщееКоличество, УжеОбработано, Подпись)

	Удалено = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Цел(РазмерПорции), "ЧГ=0") + "
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	" + ОписаниеОбъекта.ПолноеИмя + " КАК Таблица"
	+ ТекстУсловияОбрезки(ОписаниеОбъекта.ПолноеИмя, ОписаниеОбъекта.РеквизитПериода) + "
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	Если ЗначениеЗаполнено(ДатаОтсечки) Тогда
		Запрос.УстановитьПараметр("ДатаОтсечки", ДатаОтсечки);
	КонецЕсли;

	Пока Истина Цикл
		ОбработкаПрерыванияПользователя();
		// Постраничная выборка остатка таблицы: объект Запрос создан один раз вне
		// цикла, текст не меняется. Это не запрос на каждый элемент, а единственный
		// способ удалять большую таблицу порциями, поэтому диагностика подавлена.
		// BSLLS:CreateQueryInCycle-off
		РезультатЗапроса = Запрос.Выполнить();
		// BSLLS:CreateQueryInCycle-on
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;

		Выборка = РезультатЗапроса.Выбрать();
		УдаленоВПорции = 0;
		НачатьТранзакцию();
		Попытка
			Пока Выборка.Следующий() Цикл
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
					УдаленоВПорции = УдаленоВПорции + 1;
					Если УдаленоВПорции % 100 = 0 Тогда
						ПоказатьПрогресс(Подпись, УжеОбработано + Удалено + УдаленоВПорции, ОбщееКоличество);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = ОписаниеОшибки();
			ДобавитьВЛог("ОШИБКА удаления " + ОписаниеОбъекта.ПолноеИмя + ": " + ТекстОшибки);
			ЗаписьЖурналаРегистрации("ОчисткаКопииДляDev.Удаление",
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Прервать;
		КонецПопытки;

		Удалено = Удалено + УдаленоВПорции;

		Если УдаленоВПорции = 0 Тогда
			// Выборка не пуста, но удалить не удалось — защита от зацикливания.
			ДобавитьВЛог("Прервано на " + ОписаниеОбъекта.ПолноеИмя
				+ ": не удалось удалить очередную порцию (возможна блокировка записей).");
			Прервать;
		КонецЕсли;

		ПоказатьПрогресс(Подпись, УжеОбработано + Удалено, ОбщееКоличество);
	КонецЦикла;

	ДобавитьВЛог("Удалено из " + ОписаниеОбъекта.ПолноеИмя + ": " + Формат(Удалено, "ЧГ=0"));
	Возврат Удалено;

КонецФункции

// Очищает независимый регистр сведений. Маленький регистр удаляется целиком
// одной транзакцией, большой — порциями ключей по РазмерПорции, каждая порция
// в своей короткой транзакции. Порционность не даёт транзакции заблокировать
// таблицу целиком, поддерживает прерывание (Ctrl+Break) и повторный запуск.
//
// Параметры:
//  ОписаниеОбъекта - Структура - поля ПолноеИмя, Вид, ИмяКороткое, Количество.
//  ОбщееКоличество - Число - всего записей по выбранным объектам (для прогресса).
//  УжеОбработано - Число - удалено до этого объекта (для прогресса).
//  Подпись - Строка - текст для окна состояния, например "[3/12] РегистрСведений.Почта".
//
// Возвращаемое значение:
//  Число - количество удалённых записей регистра.
//
Функция ОчиститьРегистрСведений(ОписаниеОбъекта, ОбщееКоличество, УжеОбработано, Подпись)

	МетаРегистра = Метаданные.РегистрыСведений[ОписаниеОбъекта.ИмяКороткое];
	Периодический = РегистрПериодический(ОписаниеОбъекта.ИмяКороткое);

	ИменаИзмерений = Новый Массив;
	Для Каждого Измерение Из МетаРегистра.Измерения Цикл
		ИменаИзмерений.Добавить(Измерение.Имя);
	КонецЦикла;

	БезКлючевыхПолей = ИменаИзмерений.Количество() = 0 И НЕ Периодический;
	// При обрезке по периоду регистр нельзя чистить целиком — нужен отбор по дате,
	// поэтому даже маленький регистр идёт порционным путём с условием.
	Если (ОписаниеОбъекта.Количество <= РазмерПорции Или БезКлючевыхПолей)
		И НЕ ЗначениеЗаполнено(ДатаОтсечки) Тогда
		Возврат ОчиститьРегистрЦеликом(ОписаниеОбъекта, ОбщееКоличество, УжеОбработано, Подпись);
	КонецЕсли;

	Удалено = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаКлючейРегистра(ОписаниеОбъекта.ПолноеИмя, ИменаИзмерений,
		Периодический, ОписаниеОбъекта.РеквизитПериода);
	Если ЗначениеЗаполнено(ДатаОтсечки) Тогда
		Запрос.УстановитьПараметр("ДатаОтсечки", ДатаОтсечки);
	КонецЕсли;

	Пока Истина Цикл
		ОбработкаПрерыванияПользователя();
		// Постраничная выборка остатка регистра: объект Запрос создан один раз вне
		// цикла, текст не меняется. Это не запрос на каждый элемент, а единственный
		// способ удалять большой регистр порциями, поэтому диагностика подавлена.
		// BSLLS:CreateQueryInCycle-off
		РезультатЗапроса = Запрос.Выполнить();
		// BSLLS:CreateQueryInCycle-on
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;

		Выборка = РезультатЗапроса.Выбрать();
		УдаленоВПорции = 0;
		НачатьТранзакцию();
		Попытка
			// Набор переиспользуется внутри порции: для каждого ключа переустанавливается
			// отбор и пустой набор записывается с замещением, что удаляет запись.
			НаборЗаписей = РегистрыСведений[ОписаниеОбъекта.ИмяКороткое].СоздатьНаборЗаписей();
			Пока Выборка.Следующий() Цикл
				Для Каждого ИмяИзмерения Из ИменаИзмерений Цикл
					НаборЗаписей.Отбор[ИмяИзмерения].Установить(Выборка[ИмяИзмерения]);
				КонецЦикла;
				Если Периодический Тогда
					НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
				КонецЕсли;
				НаборЗаписей.Записать(Истина);
				УдаленоВПорции = УдаленоВПорции + 1;
				Если УдаленоВПорции % 100 = 0 Тогда
					ПоказатьПрогресс(Подпись, УжеОбработано + Удалено + УдаленоВПорции, ОбщееКоличество);
				КонецЕсли;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = ОписаниеОшибки();
			ДобавитьВЛог("ОШИБКА очистки " + ОписаниеОбъекта.ПолноеИмя + ": " + ТекстОшибки);
			ЗаписьЖурналаРегистрации("ОчисткаКопииДляDev.Удаление",
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Прервать;
		КонецПопытки;

		Удалено = Удалено + УдаленоВПорции;

		Если УдаленоВПорции = 0 Тогда
			// Выборка не пуста, но удалить не удалось — защита от зацикливания.
			ДобавитьВЛог("Прервано на " + ОписаниеОбъекта.ПолноеИмя
				+ ": не удалось удалить очередную порцию (возможна блокировка записей).");
			Прервать;
		КонецЕсли;

		ПоказатьПрогресс(Подпись, УжеОбработано + Удалено, ОбщееКоличество);
	КонецЦикла;

	ДобавитьВЛог("Удалено из " + ОписаниеОбъекта.ПолноеИмя + ": " + Формат(Удалено, "ЧГ=0"));
	Возврат Удалено;

КонецФункции

// Удаляет все записи независимого регистра сведений одной операцией: запись
// пустого набора с замещением и без отбора очищает таблицу. Применяется для
// небольших регистров, где порционный перебор не нужен.
//
// Параметры:
//  ОписаниеОбъекта - Структура - поля ПолноеИмя, Вид, ИмяКороткое, Количество.
//  ОбщееКоличество - Число - всего записей по выбранным объектам (для прогресса).
//  УжеОбработано - Число - удалено до этого объекта (для прогресса).
//  Подпись - Строка - текст для окна состояния, например "[3/12] РегистрСведений.Почта".
//
// Возвращаемое значение:
//  Число - количество удалённых записей регистра.
//
Функция ОчиститьРегистрЦеликом(ОписаниеОбъекта, ОбщееКоличество, УжеОбработано, Подпись)

	Процент = Цел(УжеОбработано / Макс(ОбщееКоличество, 1) * 100);
	Состояние(Подпись + "  очистка регистра целиком, подождите", Процент);

	НаборЗаписей = РегистрыСведений[ОписаниеОбъекта.ИмяКороткое].СоздатьНаборЗаписей();
	НачатьТранзакцию();
	Попытка
		НаборЗаписей.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОписаниеОшибки();
		ДобавитьВЛог("ОШИБКА очистки " + ОписаниеОбъекта.ПолноеИмя + ": " + ТекстОшибки);
		ЗаписьЖурналаРегистрации("ОчисткаКопииДляDev.Удаление",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Возврат 0;
	КонецПопытки;

	ДобавитьВЛог("Очищен регистр " + ОписаниеОбъекта.ПолноеИмя + ": "
		+ Формат(ОписаниеОбъекта.Количество, "ЧГ=0") + " записей");
	Возврат ОписаниеОбъекта.Количество;

КонецФункции

// Строит текст запроса выборки ключей записей регистра порциями по РазмерПорции:
// измерения (и период для периодического регистра) с псевдонимами и упорядочиванием.
// При активной обрезке добавляет отбор записей старше даты отсечки.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя таблицы, например "РегистрСведений.Почта".
//  ИменаИзмерений - Массив - имена измерений регистра.
//  Периодический - Булево - Истина, если регистр периодический (добавляется Период).
//  РеквизитПериода - Строка - имя поля-даты для обрезки (Период) или пустая строка.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаКлючейРегистра(ПолноеИмя, ИменаИзмерений, Периодический, РеквизитПериода)

	ПоляВыборки = "";
	Псевдонимы = "";
	Для Каждого ИмяИзмерения Из ИменаИзмерений Цикл
		ДобавитьПолеЗапроса(ПоляВыборки, "Таблица." + ИмяИзмерения + " КАК " + ИмяИзмерения);
		ДобавитьПолеЗапроса(Псевдонимы, ИмяИзмерения);
	КонецЦикла;
	Если Периодический Тогда
		ДобавитьПолеЗапроса(ПоляВыборки, "Таблица.Период КАК Период");
		ДобавитьПолеЗапроса(Псевдонимы, "Период");
	КонецЕсли;

	Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Цел(РазмерПорции), "ЧГ=0") + "
	|	" + ПоляВыборки + "
	|ИЗ
	|	" + ПолноеИмя + " КАК Таблица"
	+ ТекстУсловияОбрезки(ПолноеИмя, РеквизитПериода) + "
	|УПОРЯДОЧИТЬ ПО
	|	" + Псевдонимы;
	Возврат Текст;

КонецФункции

// Добавляет поле к накапливаемому списку полей запроса через запятую и перенос.
//
// Параметры:
//  СписокПолей - Строка - накапливаемый список (изменяется).
//  Поле - Строка - добавляемое поле.
//
Процедура ДобавитьПолеЗапроса(СписокПолей, Поле)

	Если НЕ ПустаяСтрока(СписокПолей) Тогда
		СписокПолей = СписокПолей + ", ";
	КонецЕсли;
	СписокПолей = СписокПолей + Поле;

КонецПроцедуры

// Определяет, периодический ли независимый регистр сведений. Системное
// перечисление ПериодичностьРегистраСведений в обычном приложении этой платформы
// недоступно, поэтому периодичность проверяется по наличию поля Период в отборе
// набора записей: у непериодического регистра его нет, и обращение к нему даёт
// ожидаемое исключение.
//
// Параметры:
//  ИмяКороткое - Строка - имя регистра сведений без префикса.
//
// Возвращаемое значение:
//  Булево - Истина, если регистр периодический.
//
Функция РегистрПериодический(ИмяКороткое)

	Набор = РегистрыСведений[ИмяКороткое].СоздатьНаборЗаписей();
	Попытка
		ОтборПериода = Набор.Отбор.Период;
	Исключение
		// У непериодического регистра поля Период в отборе нет — это норма.
		Возврат Ложь;
	КонецПопытки;

	Возврат ОтборПериода <> Неопределено;

КонецФункции

// Оставляет из списка только объекты, к которым применима обрезка по периоду:
// ссылочные — с заданным реквизитом-датой, регистры — периодические (отбор по
// полю Период). Объекты без реквизита-даты пропускаются с пометкой в логе, чтобы
// при заданной дате отсечки случайно не удалить их целиком.
//
// Параметры:
//  Объекты - Массив - описания объектов из СписокОбъектов().
//
// Возвращаемое значение:
//  Массив - подмножество, поддерживающее обрезку по периоду.
//
Функция ОтобратьОбрезаемые(Объекты)

	Отобранные = Новый Массив;
	Для Каждого ОписаниеОбъекта Из Объекты Цикл
		Если ОписаниеОбъекта.Вид = "Регистр" Тогда
			Если РегистрПериодический(ОписаниеОбъекта.ИмяКороткое) Тогда
				ОписаниеОбъекта.РеквизитПериода = "Период";
			Иначе
				ДобавитьВЛог("Пропущен (регистр непериодический, обрезка неприменима): "
					+ ОписаниеОбъекта.ПолноеИмя);
				Продолжить;
			КонецЕсли;
		ИначеЕсли ПустаяСтрока(ОписаниеОбъекта.РеквизитПериода) Тогда
			ДобавитьВЛог("Пропущен (нет реквизита-даты для обрезки): " + ОписаниеОбъекта.ПолноеИмя);
			Продолжить;
		КонецЕсли;
		Отобранные.Добавить(ОписаниеОбъекта);
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

// Возвращает фрагмент запроса "ГДЕ <реквизит> < &ДатаОтсечки" для отбора записей
// старше даты отсечки, либо пустую строку, если обрезка не активна или реквизит
// не задан. Для иерархического справочника добавляет исключение групп, чтобы
// удалять только записи-листья и не разрушать иерархию. Псевдоним таблицы в
// вызывающих запросах — "Таблица".
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта.
//  РеквизитПериода - Строка - имя реквизита-даты или пустая строка.
//
// Возвращаемое значение:
//  Строка - текст условия с ведущим переносом строки или пустая строка.
//
Функция ТекстУсловияОбрезки(ПолноеИмя, РеквизитПериода)

	Если НЕ ЗначениеЗаполнено(ДатаОтсечки) Или ПустаяСтрока(РеквизитПериода) Тогда
		Возврат "";
	КонецЕсли;

	Условие = "
	|ГДЕ
	|	Таблица." + РеквизитПериода + " < &ДатаОтсечки";
	Если СсылочныйОбъектИмеетГруппы(ПолноеИмя) Тогда
		Условие = Условие + "
	|	И НЕ Таблица.ЭтоГруппа";
	КонецЕсли;
	Возврат Условие;

КонецФункции

// Определяет, есть ли у ссылочного объекта группы (поле ЭтоГруппа). Проверяется
// по наличию стандартного реквизита ЭтоГруппа: он есть у справочника с иерархией
// групп и отсутствует у документа, регистра и справочника без групп.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта, например "Справочник.X".
//
// Возвращаемое значение:
//  Булево - Истина, если у объекта есть группы.
//
Функция СсылочныйОбъектИмеетГруппы(ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		СтандартныеРеквизиты = ОбъектМетаданных.СтандартныеРеквизиты;
	Исключение
		// У объекта нет коллекции стандартных реквизитов — групп точно нет.
		Возврат Ложь;
	КонецПопытки;

	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = "ЭтоГруппа" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Возвращает количество записей в таблице объекта. При активной обрезке считает
// только записи, попадающие под удаление (старше даты отсечки, без групп).
//
// Параметры:
//  ПолноеИмя - Строка - полное имя таблицы, например "Справочник.Файлы".
//  РеквизитПериода - Строка - имя реквизита-даты для обрезки или пустая строка.
//
// Возвращаемое значение:
//  Число - количество записей.
//
Функция КоличествоЗаписей(ПолноеИмя, РеквизитПериода = "")

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	" + ПолноеИмя + " КАК Таблица"
	+ ТекстУсловияОбрезки(ПолноеИмя, РеквизитПериода);
	Если ЗначениеЗаполнено(ДатаОтсечки) Тогда
		Запрос.УстановитьПараметр("ДатаОтсечки", ДатаОтсечки);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Собирает список объектов к удалению по отмеченным флажкам категорий.
//
// Возвращаемое значение:
//  Массив - элементы-структуры с полями ПолноеИмя, Вид, ИмяКороткое, Количество.
//
Функция СписокОбъектов()

	Список = Новый Массив;

	Если ФлЖурналИзменений Тогда
		ДобавитьСсылочный(Список, "Справочник.ЖурналРегистрацииИзмененияОбъектов_AEMZ", "Период");
	КонецЕсли;

	Если ФлИсторияРаботы Тогда
		ДобавитьСсылочный(Список, "Справочник.ИсторияРаботыПользователей", "Дата");
		ДобавитьСсылочный(Список, "Справочник.История");
		ДобавитьСсылочный(Список, "Справочник.КлиентыИстория", "Дата");
		ДобавитьСсылочный(Список, "Справочник.КлиентыИсторияИзмененияБаланса", "Дата");
	КонецЕсли;

	Если ФлСинхрБитрикс Тогда
		ДобавитьРегистр(Список, "SoftProCRM_Битрикс24_Идентификаторы");
	КонецЕсли;

	Если ФлОчередиСинхр Тогда
		ДобавитьРегистр(Список, "SoftProCRM_НужноСинхронизироватьСВэбИнтерфейсом");
		ДобавитьРегистр(Список, "SoftProCRM_НужноСинхронизироватьСВэбКабинетом");
		ДобавитьРегистр(Список, "SoftProCRM_НужноСинхронизироватьСAmoCRM");
		ДобавитьРегистр(Список, "SoftProCRM_НужноСинхронизироватьСАТС");
	КонецЕсли;

	Если ФлЗвонкиЧаты Тогда
		ДобавитьРегистр(Список, "SoftProCRM_ЖурналЗвонков");
		ДобавитьРегистр(Список, "SoftProCRM_СообщенияЧатов");
		ДобавитьРегистр(Список, "SoftProCRM_КонтактыСКлиентами");
		ДобавитьРегистр(Список, "ЛогПодключений");
	КонецЕсли;

	Если ФлПочта Тогда
		ДобавитьСсылочный(Список, "Справочник.Письма");
		ДобавитьСсылочный(Список, "Документ.ЭлектронноеПисьмо");
		ДобавитьРегистр(Список, "Почта");
		ДобавитьРегистр(Список, "ПочтаВложение");
	КонецЕсли;

	Если ФлУведомленияФайлы Тогда
		ДобавитьСсылочный(Список, "Справочник.SoftProCRM_Уведомления");
		ДобавитьСсылочный(Список, "Справочник.Файлы");
	КонецЕсли;

	Если ФлЗадачи Тогда
		ДобавитьСсылочный(Список, "Справочник.CRM_Задачи");
	КонецЕсли;

	Возврат Список;

КонецФункции

Процедура ДобавитьСсылочный(Список, ПолноеИмя, РеквизитПериода = "")

	Описание = Новый Структура("ПолноеИмя, Вид, ИмяКороткое, Количество, РеквизитПериода");
	Описание.ПолноеИмя = ПолноеИмя;
	Описание.Вид = "Ссылочный";
	Описание.ИмяКороткое = "";
	Описание.Количество = 0;
	Описание.РеквизитПериода = РеквизитПериода;
	Список.Добавить(Описание);

КонецПроцедуры

Процедура ДобавитьРегистр(Список, ИмяРегистра)

	Описание = Новый Структура("ПолноеИмя, Вид, ИмяКороткое, Количество, РеквизитПериода");
	Описание.ПолноеИмя = "РегистрСведений." + ИмяРегистра;
	Описание.Вид = "Регистр";
	Описание.ИмяКороткое = ИмяРегистра;
	Описание.Количество = 0;
	Описание.РеквизитПериода = "";
	Список.Добавить(Описание);

КонецПроцедуры

// Выводит прогресс в строку состояния: подпись объекта, процент и счётчик.
// Текст идёт первым параметром, потому что в обычном приложении в строке
// состояния отображается именно он (второй параметр — для индикатора-полосы).
//
// Параметры:
//  Подпись - Строка - подпись текущего объекта, например "[3/12] Справочник.Файлы".
//  Текущее - Число - сколько записей удалено к этому моменту.
//  Всего - Число - общее число записей к удалению.
//
Процедура ПоказатьПрогресс(Подпись, Текущее, Всего)

	Процент = Цел(Текущее / Макс(Всего, 1) * 100);
	Состояние(Подпись + "  " + Процент + "%  удалено "
		+ Формат(Текущее, "ЧГ=0") + " из " + Формат(Всего, "ЧГ=0"), Процент);

КонецПроцедуры

Процедура ДобавитьВЛог(Текст)

	Префикс = "";
	Если НЕ ПустаяСтрока(ТекстРезультата) Тогда
		Префикс = Символы.ПС;
	КонецЕсли;
	ТекстРезультата = ТекстРезультата + Префикс
		+ Формат(ТекущаяДатаСеанса(), "ДФ=ЧЧ:мм:сс") + "  " + Текст;

КонецПроцедуры

#КонецОбласти
