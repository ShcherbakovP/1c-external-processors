Функция ЯЗагружаюИнтернетЗаказ(НомерЗаказа) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;

	// Устанавливаем ОткрытаДляТестирования через вызов ВвестиШтрихкодИзвне
	// с пустым значением — оно будет отклонено, но флаг тестирования установится
	Форма.ВвестиШтрихкодИзвне("");

	// Загружаем заказ через механизм оповещений.
	// УИДФормы в ПомощникПродавца изначально Неопределено,
	// поэтому передаём Неопределено — проверка пройдёт
	Параметр = Новый Структура;
	Параметр.Вставить("УИДФормы", Неопределено);
	Параметр.Вставить("Заказ", НомерЗаказа);

	Оповестить("ОбработкаПодбораИнтернетЗаказа", Параметр);
КонецФункции

