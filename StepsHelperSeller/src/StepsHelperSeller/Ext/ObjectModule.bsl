///////////////////////////////////////////////////
//Хелпер: получение активной формы через ОкнаФорм
///////////////////////////////////////////////////

Функция ПолучитьФормуИзОкна()
	Если ТекущаяФорма <> Неопределено Тогда
		Возврат ТекущаяФорма;
	КонецЕсли;
	Попытка
		КонтекстОкон = Вычислить("ОкнаФорм");
		Окна = КонтекстОкон.ПолучитьВсеОкна();
		Для Каждого Окно Из Окна Цикл
			Форма = Окно.ПолучитьФорму();
			Если Форма <> Неопределено Тогда
				ТекущаяФорма = Форма;
				Возврат ТекущаяФорма;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

