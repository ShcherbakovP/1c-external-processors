Функция ОбработкаСуществуетВКонфигурации(ИмяОбработки) Экспорт
	Попытка
		МетаданныеОбработки = Метаданные.Обработки[ИмяОбработки];
		Если МетаданныеОбработки = Неопределено Тогда
			ВызватьИсключение "Обработка " + ИмяОбработки + " не найдена в конфигурации";
		КонецЕсли;
	Исключение
		ВызватьИсключение "Обработка " + ИмяОбработки + " не существует в конфигурации: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ЯОткрываюОбработку(ИмяОбработки) Экспорт
	Попытка
		ФормаОбработки = Обработки[ИмяОбработки].ПолучитьФорму("Форма");
		ФормаОбработки.Открыть();
		ТекущаяФорма = ФормаОбработки;
	Исключение
		Попытка
			ОткрытьФорму("Обработка." + ИмяОбработки + ".Форма");
		Исключение
			ВызватьИсключение "Не удалось открыть обработку " + ИмяОбработки + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция ФормаОбработкиОткрыта() Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма обработки не открыта";
	КонецЕсли;
КонецФункции

Функция ФормаСодержитРеквизит(ИмяРеквизита) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	Попытка
		Значение = Форма[ИмяРеквизита];
	Исключение
		ВызватьИсключение "Реквизит " + ИмяРеквизита + " не найден на форме";
	КонецПопытки;
КонецФункции

Функция ОбработкаОткрыта(ИмяОбработки) Экспорт
	Попытка
		ФормаОбработки = Обработки[ИмяОбработки].ПолучитьФорму("Форма");
		ФормаОбработки.Открыть();
		ТекущаяФорма = ФормаОбработки;
	Исключение
		Попытка
			ОткрытьФорму("Обработка." + ИмяОбработки + ".Форма");
		Исключение
			ВызватьИсключение "Не удалось открыть обработку " + ИмяОбработки + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция ФормаСодержитТабличнуюЧасть(ИмяТабличнойЧасти) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	Попытка
		ТЧ = Форма.ЭлементыФормы[ИмяТабличнойЧасти];
		Если ТЧ = Неопределено Тогда
			ВызватьИсключение "Табличная часть " + ИмяТабличнойЧасти + " не найдена";
		КонецЕсли;
	Исключение
		ВызватьИсключение "Табличная часть " + ИмяТабличнойЧасти + " не найдена: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ТабличнаяЧастьСодержитКолонку(ИмяТабличнойЧасти, ИмяКолонки) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	Попытка
		ОбъектФормы = Форма.ВладелецФормы;
		ТабличнаяЧасть = ОбъектФормы[ИмяТабличнойЧасти];
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		Значение = НоваяСтрока[ИмяКолонки];
		ТабличнаяЧасть.Удалить(НоваяСтрока);
	Исключение
		ВызватьИсключение "Колонка " + ИмяКолонки + " не найдена в " + ИмяТабличнойЧасти + ": " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция ВБазеДанныхСуществуетНоменклатураСШтрихкодом(Штрихкод) Экспорт
	Если ПустаяСтрока(Штрихкод) Тогда
		ВызватьИсключение "Штрихкод не может быть пустым";
	КонецЕсли;
КонецФункции

Функция ЯВвожуШтрихкодВПоле(Штрихкод, ИмяПоля) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	Попытка
		Форма.ВвестиШтрихкодИзвне(Штрихкод);
		Форма.Активизировать();
	Исключение
		ВызватьИсключение "Ошибка ввода штрихкода: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция НажимаюКлавишу(Парам01) Экспорт
	Счетчик = 0;
	Пока Счетчик < 10 Цикл
		Счетчик = Счетчик + 1;
	КонецЦикла;
КонецФункции

Функция ВТабличнойЧастиДобавленаСтрока(ИмяТабличнойЧасти) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	ОбъектФормы = Форма.ВладелецФормы;
	ТабличнаяЧасть = ОбъектФормы[ИмяТабличнойЧасти];
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		ВызватьИсключение "В табличной части " + ИмяТабличнойЧасти + " нет строк";
	КонецЕсли;
КонецФункции

Функция ВСтрокеЗаполненоПоле(ИмяПоля) Экспорт
	Форма = ПолучитьФормуИзОкна();
	Если Форма = Неопределено Тогда
		ВызватьИсключение "Форма не найдена";
	КонецЕсли;
	ОбъектФормы = Форма.ВладелецФормы;
	ТабличнаяЧасть = ОбъектФормы.ТабличнаяЧасть1;
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		ВызватьИсключение "В табличной части нет строк";
	КонецЕсли;
	СтрокаТЧ = ТабличнаяЧасть[ТабличнаяЧасть.Количество() - 1];
	Попытка
		Значение = СтрокаТЧ[ИмяПоля];
		Если Значение = Неопределено Или ПустаяСтрока(Строка(Значение)) Тогда
			ВызватьИсключение "Поле " + ИмяПоля + " не заполнено";
		КонецЕсли;
	Исключение
