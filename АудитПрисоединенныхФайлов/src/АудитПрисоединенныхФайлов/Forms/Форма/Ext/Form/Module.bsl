#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПутьКCSV = "C:\Temp\АудитФайлов.csv";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыполнитьАудит(Команда)

	Состояние("Выполняется аудит присоединённых файлов...");
	ВыполнитьАудитНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьCSV(Команда)

	Если НЕ ЗначениеЗаполнено(ПутьКCSV) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Путь к CSV не задан.");
		Возврат;
	КонецЕсли;

	Попытка
		ЗапуститьПриложение(ПутьКCSV);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Не удалось открыть файл: " + ПутьКCSV + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьАудитНаСервере()

	Попытка
		// &НаСервере с контекстом нужен, чтобы передать ТабДок обратно в реквизит формы
		// и чтобы вызвать методы объекта обработки через РеквизитФормыВЗначение.
		Обработка = РеквизитФормыВЗначение("Объект");
		ИтогАудита = Обработка.ВыполнитьАудит(ПутьКCSV, ТолькоНеСуществующие);
		ЗначениеВРеквизитФормы(ИтогАудита.ТабДок, "Результат");
		СформироватьСообщениеОбИтогах(ИтогАудита);
	Исключение
		ЗаписьЖурналаРегистрации("АудитПрисоединенныхФайлов", УровеньЖурналаРегистрации.Ошибка,
			, , ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(
			"Аудит завершился с ошибкой: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СформироватьСообщениеОбИтогах(ИтогАудита)

	ПроцентПотерь = "0";
	Если ИтогАудита.ВсегоЗаписей > 0 Тогда
		ПроцентПотерь = Формат(
			ИтогАудита.ВсегоПотеряно / ИтогАудита.ВсегоЗаписей * 100, "ЧДЦ=1; ЧН=0");
	КонецЕсли;

	ТекстИтога = СтрШаблон(
		"Аудит завершён. Проверено: %1. Найдено: %2. Потеряно: %3 (%4%%).",
		Формат(ИтогАудита.ВсегоЗаписей,  "ЧГ=0"),
		Формат(ИтогАудита.ВсегоНайдено,  "ЧГ=0"),
		Формат(ИтогАудита.ВсегоПотеряно, "ЧГ=0"),
		ПроцентПотерь
	);
	ОбщегоНазначения.СообщитьПользователю(ТекстИтога);

КонецПроцедуры

#КонецОбласти
