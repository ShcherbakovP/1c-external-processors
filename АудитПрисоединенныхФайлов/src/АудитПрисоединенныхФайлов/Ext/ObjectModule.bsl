#Область ПрограммныйИнтерфейс

// Выполняет аудит присоединённых файлов типа «НаСервере»:
// сверяет записи справочника с физическими файлами на шаре.
//
// Параметры:
//   ПутьКCSVФайлу    - Строка - путь для сохранения детализации (пусто = не сохранять)
//   ТолькоПотерянные - Булево - Истина: в CSV только потерянные; Ложь: все записи
//
// Возвращаемое значение:
//   Структура:
//     * ТабДок            - ТабличныйДокумент - сводка аудита
//     * ВсегоЗаписей      - Число             - кол-во записей в БД с типом НаСервере
//     * ВсегоНайдено      - Число             - кол-во записей с файлом на шаре
//     * ВсегоПотеряно     - Число             - кол-во записей без файла на шаре
//     * ВсегоФайловНаШаре - Число             - физических файлов на шаре
Функция ВыполнитьАудит(ПутьКCSVФайлу, ТолькоПотерянные) Экспорт

	БазовыйПуть = НормализоватьПуть(Константы.ПутьККаталогуХранилища.Получить());
	ПроверитьДоступностьКаталога(БазовыйПуть);

	ИндексФайлов  = ПостроитьИндексФайлов(БазовыйПуть);
	ТаблицаПотерь = СоздатьТаблицуПотерь();
	СтатПоТипам   = Новый Соответствие;

	ВсегоЗаписей  = 0;
	ВсегоНайдено  = 0;
	ВсегоПотеряно = 0;

	ОбработатьВыборку(БазовыйПуть, ИндексФайлов, ТаблицаПотерь, СтатПоТипам,
		ВсегоЗаписей, ВсегоНайдено, ВсегоПотеряно);

	ВсегоФайловНаШаре = ИндексФайлов.Количество();

	ТабДок = СформироватьТабДок(БазовыйПуть, ВсегоЗаписей, ВсегоНайдено,
		ВсегоПотеряно, ВсегоФайловНаШаре, СтатПоТипам);

	Если ЗначениеЗаполнено(ПутьКCSVФайлу) Тогда
		СохранитьCSV(ПутьКCSVФайлу, ТаблицаПотерь, ТолькоПотерянные);
	КонецЕсли;

	ИтогВызова = Новый Структура;
	ИтогВызова.Вставить("ТабДок",            ТабДок);
	ИтогВызова.Вставить("ВсегоЗаписей",      ВсегоЗаписей);
	ИтогВызова.Вставить("ВсегоНайдено",      ВсегоНайдено);
	ИтогВызова.Вставить("ВсегоПотеряно",     ВсегоПотеряно);
	ИтогВызова.Вставить("ВсегоФайловНаШаре", ВсегоФайловНаШаре);
	Возврат ИтогВызова;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Убирает завершающий обратный слеш из пути.
Функция НормализоватьПуть(Знач Путь)

	Если Прав(Путь, 1) = "\" Тогда
		Возврат Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	Возврат Путь;

КонецФункции

// Проверяет, что каталог существует и доступен; выбрасывает исключение иначе.
Процедура ПроверитьДоступностьКаталога(БазовыйПуть)

	КаталогОбъект = Новый Файл(БазовыйПуть);
	Если НЕ КаталогОбъект.Существует() ИЛИ НЕ КаталогОбъект.ЭтоКаталог() Тогда
		ВызватьИсключение СтрШаблон("Каталог хранилища недоступен: %1", БазовыйПуть);
	КонецЕсли;

КонецПроцедуры

// Сканирует плоский каталог и возвращает Соответствие «имяфайла_нрег → Истина».
// НайтиФайлы с рекурсией=Ложь — только корневой уровень шары, O(N).
Функция ПостроитьИндексФайлов(БазовыйПуть)

	НайденныеФайлы = НайтиФайлы(БазовыйПуть, "*", Ложь);
	Индекс = Новый Соответствие;
	Для Каждого Ф Из НайденныеФайлы Цикл
		Если Ф.ЭтоФайл() Тогда
			Индекс.Вставить(НРег(Ф.Имя), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

// Создаёт пустую ТаблицуЗначений для детализации записей.
Функция СоздатьТаблицуПотерь()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Наименование",  Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Расширение",    Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Владелец");
	Таблица.Колонки.Добавить("ТипВладельца",  Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ОжидаемыйПуть", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Размер",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;

КонецФункции

// Выполняет один пакетный запрос к справочнику (тип НаСервере, без пометки удаления)
// и обходит выборку, накапливая статистику по типам владельцев.
// Счётчики передаются по ссылке (Процедура изменяет их).
Процедура ОбработатьВыборку(БазовыйПуть, ИндексФайлов, ТаблицаПотерь, СтатПоТипам,
	ВсегоЗаписей, ВсегоНайдено, ВсегоПотеряно)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Файл.Ссылка        КАК Ссылка,
	|	Файл.Наименование  КАК Наименование,
	|	Файл.Расширение    КАК Расширение,
	|	Файл.ВладелецФайла КАК ВладелецФайла,
	|	ЕСТЬNULL(Файл.Размер, 0) КАК Размер
	|ИЗ
	|	Справочник.ПрисоединенныеФайлы КАК Файл
	|ГДЕ
	|	Файл.ТипХранения = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.НаСервере)
	|	И НЕ Файл.ПометкаУдаления";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// Кеш типов владельцев по типу значения — не вызываем Метаданные() повторно
	КешТипов = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		ВсегоЗаписей = ВсегоЗаписей + 1;

		ИмяФайла = НРег(
			Строка(Выборка.Ссылка.УникальныйИдентификатор()) + Выборка.Расширение
		);
		Существует = ИндексФайлов.Получить(ИмяФайла) <> Неопределено;

		ТипВладельца = ОпределитьТипВладельца(Выборка.ВладелецФайла, КешТипов);

		СтатЗаписи = СтатПоТипам.Получить(ТипВладельца);
		Если СтатЗаписи = Неопределено Тогда
			СтатЗаписи = Новый Структура("Всего, Потеряно, РазмерПотерь", 0, 0, 0);
			СтатПоТипам.Вставить(ТипВладельца, СтатЗаписи);
		КонецЕсли;
		СтатЗаписи.Всего = СтатЗаписи.Всего + 1;

		ПутьФайла = БазовыйПуть + "\" + ИмяФайла;

		Если Существует Тогда
			ВсегоНайдено = ВсегоНайдено + 1;
			ДобавитьСтрокуВТаблицу(ТаблицаПотерь, Выборка, ТипВладельца, ПутьФайла, "НАЙДЕН");
		Иначе
			ВсегоПотеряно = ВсегоПотеряно + 1;
			СтатЗаписи.Потеряно      = СтатЗаписи.Потеряно + 1;
			СтатЗаписи.РазмерПотерь = СтатЗаписи.РазмерПотерь + Выборка.Размер;
			ДобавитьСтрокуВТаблицу(ТаблицаПотерь, Выборка, ТипВладельца, ПутьФайла, "ПОТЕРЯН");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Определяет тип владельца файла через Метаданные() с кешированием по типу значения.
// Метаданные() — метод ссылки, не обращение к реквизитам объекта.
Функция ОпределитьТипВладельца(ВладелецФайла, КешТипов)

	Если НЕ ЗначениеЗаполнено(ВладелецФайла) Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(ВладелецФайла);
	ТипВладельца = КешТипов.Получить(ТипЗначения);
	Если ТипВладельца <> Неопределено Тогда
		Возврат ТипВладельца;
	КонецЕсли;

	МетаВладельца = ВладелецФайла.Метаданные();
	Если МетаВладельца = Неопределено Тогда
		ТипВладельца = "";
	Иначе
		ТипВладельца = МетаВладельца.ПолноеИмя();
	КонецЕсли;

	КешТипов.Вставить(ТипЗначения, ТипВладельца);
	Возврат ТипВладельца;

КонецФункции

// Добавляет одну строку в таблицу детализации.
Процедура ДобавитьСтрокуВТаблицу(ТаблицаПотерь, Выборка, ТипВладельца, ОжидаемыйПуть, Статус)

	НоваяСтрока = ТаблицаПотерь.Добавить();
	НоваяСтрока.Ссылка        = Выборка.Ссылка;
	НоваяСтрока.Наименование  = Выборка.Наименование;
	НоваяСтрока.Расширение    = Выборка.Расширение;
	НоваяСтрока.Владелец      = Выборка.ВладелецФайла;
	НоваяСтрока.ТипВладельца  = ТипВладельца;
	НоваяСтрока.ОжидаемыйПуть = ОжидаемыйПуть;
	НоваяСтрока.Размер        = Выборка.Размер;
	НоваяСтрока.Статус        = Статус;

КонецПроцедуры

// Формирует ТабличныйДокумент со сводкой аудита (программное построение через Область).
Функция СформироватьТабДок(БазовыйПуть, ВсегоЗаписей, ВсегоНайдено,
	ВсегоПотеряно, ВсегоФайловНаШаре, СтатПоТипам)

	ТабДок = Новый ТабличныйДокумент;

	ВывестиСтрокуТабДок(ТабДок,
		"Аудит присоединённых файлов (НаСервере)  |  "
		+ Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ "  |  Каталог: " + БазовыйПуть, Истина);

	ВывестиСтрокуТабДок(ТабДок, "", Ложь);
	ВывестиСтрокуТабДок(ТабДок, "=== СВОДКА ===", Истина);
	ВывестиСтрокуТабДок(ТабДок, "Всего записей в БД (тип НаСервере):  " + Формат(ВсегоЗаписей, "ЧГ=0"), Ложь);
	ВывестиСтрокуТабДок(ТабДок, "Файлов на шаре всего:                " + Формат(ВсегоФайловНаШаре, "ЧГ=0"), Ложь);
	ВывестиСтрокуТабДок(ТабДок, "Найдено (файл есть на шаре):         " + Формат(ВсегоНайдено, "ЧГ=0"), Ложь);
	ВывестиСтрокуТабДок(ТабДок, "Потеряно (файл отсутствует):         " + Формат(ВсегоПотеряно, "ЧГ=0"), Ложь);

	ПроцентПотерь = "н/д";
	Если ВсегоЗаписей > 0 Тогда
		ПроцентПотерь = Формат(ВсегоПотеряно / ВсегоЗаписей * 100, "ЧДЦ=1; ЧН=0") + "%";
	КонецЕсли;
	ВывестиСтрокуТабДок(ТабДок, "% потерь:                            " + ПроцентПотерь, Ложь);

	ВывестиСтрокуСирот(ТабДок, ВсегоФайловНаШаре, ВсегоЗаписей);

	ВывестиСтрокуТабДок(ТабДок, "", Ложь);
	ВывестиСтрокуТабДок(ТабДок, "=== ПО ТИПАМ ВЛАДЕЛЬЦЕВ ===", Истина);
	ВывестиТаблицуТипов(ТабДок, СтатПоТипам);

	Возврат ТабДок;

КонецФункции

// Выводит одну строку в ТабДок.
// Для заголовков (ЖирныйШрифт=Истина) к тексту добавляется префикс «** »
// (изменение шрифта через Новый Шрифт нарушает правило new-font).
Процедура ВывестиСтрокуТабДок(ТабДок, Текст, ЖирныйШрифт)

	ТекстВывода = Текст;
	Если ЖирныйШрифт И ЗначениеЗаполнено(Текст) Тогда
		ТекстВывода = "[ " + Текст + " ]";
	КонецЕсли;

	Область = ТабДок.ПолучитьОбласть("R1C1");
	Область.Текст = ТекстВывода;
	ТабДок.Вывести(Область);

КонецПроцедуры

// Выводит строку про сиротские файлы на шаре.
Процедура ВывестиСтрокуСирот(ТабДок, ВсегоФайловНаШаре, ВсегоЗаписей)

	КоличествоСирот = ВсегоФайловНаШаре - ВсегоЗаписей;
	Если КоличествоСирот > 0 Тогда
		ТекстСирот = "Файлов на шаре без записи в БД (сироты): "
			+ Формат(КоличествоСирот, "ЧГ=0");
	ИначеЕсли КоличествоСирот < 0 Тогда
		ТекстСирот = "Записей в БД больше чем файлов на шаре на: "
			+ Формат(-КоличествоСирот, "ЧГ=0")
			+ " (ожидаемо при потере файлов)";
	Иначе
		ТекстСирот = "Количество файлов на шаре совпадает с записями в БД.";
	КонецЕсли;

	ВывестиСтрокуТабДок(ТабДок, ТекстСирот, Ложь);

КонецПроцедуры

// Выводит таблицу статистики по типам владельцев, отсортированную по убыванию потерь.
Процедура ВывестиТаблицуТипов(ТабДок, СтатПоТипам)

	// Шапка таблицы
	ВывестиСтрокуТабДок(ТабДок,
		СтрШаблон("%-60s %10s %10s %10s %12s",
			"Тип владельца", "Всего", "Потеряно", "% потерь", "Потери МБ"),
		Истина);

	// Собираем строки и сортируем пузырьковой сортировкой по убыванию Потеряно.
	// Количество уникальных типов обычно < 50 — O(N²) приемлемо.
	Строки = Новый Массив;
	Для Каждого КЗ Из СтатПоТипам Цикл
		СтрокаДанных = Новый Структура("Тип, Всего, Потеряно");
		СтрокаДанных.Тип      = КЗ.Ключ;
		СтрокаДанных.Всего    = КЗ.Значение.Всего;
		СтрокаДанных.Потеряно = КЗ.Значение.Потеряно;
		СтрокаДанных.Вставить("РазмерПотерь", КЗ.Значение.РазмерПотерь);
		Строки.Добавить(СтрокаДанных);
	КонецЦикла;

	Для ИндВнешний = 0 По Строки.ВГраница() - 1 Цикл
		Для ИндВнутренний = 0 По Строки.ВГраница() - ИндВнешний - 1 Цикл
			Если Строки[ИндВнутренний].Потеряно < Строки[ИндВнутренний + 1].Потеряно Тогда
				Временная                      = Строки[ИндВнутренний];
				Строки[ИндВнутренний]           = Строки[ИндВнутренний + 1];
				Строки[ИндВнутренний + 1]       = Временная;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Стр Из Строки Цикл

		ПроцентПотерьТип = "н/д";
		Если Стр.Всего > 0 Тогда
			ПроцентПотерьТип = Формат(Стр.Потеряно / Стр.Всего * 100, "ЧДЦ=1; ЧН=0") + "%";
		КонецЕсли;

		РазмерМБ = Формат(Стр.РазмерПотерь / 1024 / 1024, "ЧДЦ=2; ЧН=0");

		НаименованиеТипа = Стр.Тип;
		Если НЕ ЗначениеЗаполнено(НаименованиеТипа) Тогда
			НаименованиеТипа = "(не определён)";
		КонецЕсли;

		ВывестиСтрокуТабДок(ТабДок,
			СтрШаблон("%-60s %10s %10s %10s %12s",
				НаименованиеТипа,
				Формат(Стр.Всего,    "ЧГ=0"),
				Формат(Стр.Потеряно, "ЧГ=0"),
				ПроцентПотерьТип,
				РазмерМБ),
			Ложь);

	КонецЦикла;

КонецПроцедуры

// Сохраняет детализацию в CSV-файл.
// Кодировка UTF-8 BOM, разделитель «;».
// Если ТолькоПотерянные = Ложь — выгружаются все записи с колонкой Статус.
Процедура СохранитьCSV(ПутьКCSVФайлу, ТаблицаПотерь, ТолькоПотерянные)

	ЗаписьФайла = Новый ЗаписьТекста(ПутьКCSVФайлу, КодировкаТекста.UTF8, , Истина);
	ЗаписьФайла.ЗаписатьСтроку(
		"Ссылка;Наименование;Расширение;Владелец;ТипВладельца;ОжидаемыйПуть;Размер;Статус");

	Для Каждого СтрокаТаблицы Из ТаблицаПотерь Цикл

		Если ТолькоПотерянные И (СтрокаТаблицы.Статус = "НАЙДЕН") Тогда
			Продолжить;
		КонецЕсли;

		ЗначенияCSV = Новый Массив;
		ЗначенияCSV.Добавить(ЭкранироватьCSV(Строка(СтрокаТаблицы.Ссылка)));
		ЗначенияCSV.Добавить(ЭкранироватьCSV(СтрокаТаблицы.Наименование));
		ЗначенияCSV.Добавить(ЭкранироватьCSV(СтрокаТаблицы.Расширение));
		ЗначенияCSV.Добавить(ЭкранироватьCSV(Строка(СтрокаТаблицы.Владелец)));
		ЗначенияCSV.Добавить(ЭкранироватьCSV(СтрокаТаблицы.ТипВладельца));
		ЗначенияCSV.Добавить(ЭкранироватьCSV(СтрокаТаблицы.ОжидаемыйПуть));
		ЗначенияCSV.Добавить(Формат(СтрокаТаблицы.Размер, "ЧГ=0"));
		ЗначенияCSV.Добавить(СтрокаТаблицы.Статус);

		ЗаписьФайла.ЗаписатьСтроку(СтрСоединить(ЗначенияCSV, ";"));

	КонецЦикла;

	ЗаписьФайла.Закрыть();

КонецПроцедуры

// Экранирует значение для CSV: оборачивает в двойные кавычки, если содержит
// разделитель «;», перенос строки или кавычку.
Функция ЭкранироватьCSV(Значение)

	ЭкранированноеЗначение = СтрЗаменить(Значение, """", """""");
	ТребуетсяОборачивание =
		СтрНайти(ЭкранированноеЗначение, ";")  > 0
		ИЛИ СтрНайти(ЭкранированноеЗначение, Символы.ПС) > 0
		ИЛИ СтрНайти(ЭкранированноеЗначение, """") > 0;

	Если ТребуетсяОборачивание Тогда
		Возврат """" + ЭкранированноеЗначение + """";
	КонецЕсли;
	Возврат ЭкранированноеЗначение;

КонецФункции

#КонецОбласти
